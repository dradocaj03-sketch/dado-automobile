rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function hasApp(app) {
      return request.auth != null
        && 'apps' in request.auth.token
        && app in request.auth.token.apps;
    }

    // Quelle der Wahrheit für Rechte. Nur Admins dürfen lesen/schreiben -
    // Vergabe läuft ausschließlich über das Verwaltungs-Panel.
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // App "Dado Automobile" - Fahrzeugbestand, Ausgaben, Nummernzähler.
    match /fahrzeuge/{doc} {
      allow read, write: if isAdmin() || hasApp('dado-automobile');
    }
    match /ausgaben/{doc} {
      allow read, write: if isAdmin() || hasApp('dado-automobile');
    }
    match /meta/vehicleCounter {
      allow read, write: if isAdmin() || hasApp('dado-automobile');
    }
    match /rechnungen/{doc} {
      allow read, write: if isAdmin() || hasApp('dado-automobile');
    }
    match /kassabuch/{doc} {
      allow read, write: if isAdmin() || hasApp('dado-automobile');
    }
    match /meta/invoiceCounter {
      allow read, write: if isAdmin() || hasApp('dado-automobile');
    }

    // Alles andere: geschlossen, bis eine App es explizit braucht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
